# Codebench Environment Configuration

# Application
CODEBENCH_ENV=development
CODEBENCH_PORT=8080
CODEBENCH_HOST=0.0.0.0
APP_SECRET=change-this-to-a-secure-random-32-byte-hex-string

# PostgreSQL Database
DATABASE_URL=postgres://codebench:codebench_secret@postgres:5432/codebench?sslmode=disable
DB_HOST=postgres
DB_PORT=5432
DB_USER=codebench
DB_PASSWORD=codebench_secret
DB_NAME=codebench

# Embedded NATS JetStream
NATS_EMBEDDED=true
NATS_PORT=4222
NATS_CLUSTER_PORT=6222
NATS_STORE_DIR=/data/nats
NATS_TOKEN=codebench-nats-internal-token-change-me

# Judge Configuration
JUDGE_CONCURRENCY=2
JUDGE_SLOT_DIR=/var/run/codebench/slots
USE_FAKE_JUDGE=false

# CORS & Frontend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080
ADMIN_DEFAULT_PASSWORD=codebench123
